# StudentIQ Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Paths
STUDENTIQ_DATA_DIR=data
STUDENTIQ_DUCKDB_PATH=data/processed/analytics.duckdb
STUDENTIQ_MODEL_PATH=data/processed/risk_model.joblib

# Risk Thresholds
ATTENDANCE_RISK_THRESHOLD=75.0
ATTENDANCE_CRITICAL_THRESHOLD=60.0
CGPA_RISK_THRESHOLD=6.0
CGPA_CRITICAL_THRESHOLD=4.5

# Ollama Integration (Optional - robust fallback included)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=5
